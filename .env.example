# CallLens Stress Lab — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit the actual .env file or your API keys to Git.

# -----------------------------------------------------------------------------
# Gnani.ai API Credentials (Required for live provider calls)
# -----------------------------------------------------------------------------
GNANI_API_KEY=your_gnani_api_key_here

# -----------------------------------------------------------------------------
# Storage & Database Locations
# -----------------------------------------------------------------------------
# Directory where audio datasets (FLEURS, BFSI, Noise), cache, and results are stored
DATA_DIR=../calllens-data

# SQLite / SQLAlchemy Database Connection URL
DATABASE_URL=sqlite:///../calllens-data/benchmark.db

# Optional: custom cache directory (defaults to $DATA_DIR/cache if unset)
# CALLENS_CACHE_DIR=../calllens-data/cache

# -----------------------------------------------------------------------------
# Safety Caps & Concurrency Controls
# -----------------------------------------------------------------------------
# Maximum live API requests permitted per session/gate (safety ceiling)
MAX_LIVE_CALLS=10

# Request timeout in seconds for Gnani STT/TTS HTTP calls
GNANI_TIMEOUT=30

# Maximum concurrent requests to Gnani endpoints (client semaphore)
GNANI_CONCURRENCY_LIMIT=2

# -----------------------------------------------------------------------------
# Web Application Server Settings
# -----------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
