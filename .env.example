# CallLens Stress Lab — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit the actual .env file or your API keys to Git.

# Gnani.ai API Credentials (Required for live mode)
GNANI_API_KEY=your_gnani_api_key_here

# Dataset and Output Storage Location
DATA_DIR=../calllens-data

# SQLite / SQLAlchemy Database Connection URL
DATABASE_URL=sqlite:///../calllens-data/benchmark.db

# Live Provider Request Safety Controls
# Maximum live API requests permitted per session/gate
MAX_LIVE_CALLS=10

# Request Concurrency & Timeout
GNANI_CONCURRENCY_LIMIT=2
GNANI_REQUEST_TIMEOUT_SEC=30

# Web Application Host and Port
APP_HOST=127.0.0.1
APP_PORT=8000

